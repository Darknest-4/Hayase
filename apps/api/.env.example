# Yume API — environment configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL (docker-compose default)
DATABASE_URL=postgres://yume:yume@localhost:5432/yume

# REQUIRED in production — generate with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated allowed origins, or * for development
CORS_ORIGINS=*
