# HTTPS for Yume.
#
# Without this the stack served plain HTTP on port 4000, so every password,
# access token and refresh token crossed the network readable. The CSP, the
# scrypt cost and the rotating refresh tokens are all worth very little when
# the channel itself is open.
#
# Caddy is used because it obtains and renews a Let's Encrypt certificate on
# its own — no certbot, no cron, no renewal that quietly stops working.
#
# Set YUME_DOMAIN in .env to your hostname. Left unset it serves plain HTTP on
# :80 for local testing, so `docker compose up` still works on a laptop.

{
	# Contact address for certificate expiry notices.
	email {$ACME_EMAIL:admin@localhost}
	# Fewer moving parts than the default: no admin API exposed.
	admin off

	# Behind Cloudflare, the visitor's address is the one Cloudflare itself
	# writes (CF-Connecting-IP), trusted only from Cloudflare's own ranges.
	# Anything else connecting is its own visitor. Without this every visitor
	# looked like a Cloudflare edge server, and the rate limiter put the whole
	# internet in one bucket. Regenerate the list with
	# scripts/cloudflare/trust-proxy.sh.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$YUME_DOMAIN::80} {
	encode zstd gzip

	# HSTS is set here rather than in the app, because it is only ever correct
	# once something actually terminates TLS — which is here.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# The websocket upgrade needs no special handling in Caddy v2; reverse_proxy
	# passes it through. X-Forwarded-For carries exactly one address — the
	# visitor as determined above — so the app only has to trust this proxy
	# (TRUST_PROXY=172.16.0.0/12, the compose default).
	reverse_proxy app:4000 {
		header_up X-Forwarded-For {client_ip}
		health_uri /v1/health
		health_interval 30s
	}
}
