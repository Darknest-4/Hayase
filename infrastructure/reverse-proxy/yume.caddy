# YUME — a reverse proxy YUME-hoz tartozó része.
#
# EZ A FÁJL AZ IGAZSÁGFORRÁS. Az éles Caddyfile a repón KÍVÜL él
# (`/opt/YonagiFansub/Caddyfile`), mert ugyanaz a Caddy három oldalt szolgál ki
# ezen a gépen — a YUME-t, a YonagiFansubot és egy harmadik API-t. Ezért nem
# lehet egyszerűen bemásolni ide az egészet: a másik két projekt nem a miénk.
#
# A megoldás: a YUME BLOKKJA itt él, és a `scripts/reverse-proxy/install.sh`
# teszi a helyére a közös fájlban, a jelölők közé, HELYBEN írva. A helyben
# írás nem stílus — egy `mv` új inode-ot hoz létre, a fájlszintű bind mount
# pedig a régit tartja, és a `caddy reload` erre azt mondja, hogy „config is
# unchanged". Ez megtörtént; azóta minden írás helyben megy.
#
# Egyetlen gépre telepített, önálló YUME-hoz nem ez kell, hanem a
# `Caddyfile` ebben a könyvtárban: az `YUME_DOMAIN`-ből dolgozik, és a
# `docker compose --profile proxy up` indítja.
#
# A tartománylistákat NE kézzel írd: `scripts/cloudflare/trust-proxy.sh`.

# ---- globális beállítás (a közös fájl tetejére kerül) ----
{
	# A CLOUDFLARE CÍMEI — generálva, nem kézzel másolva.
	#
	# A Caddy 2.7 óta alapból NEM hiszi el a beérkező X-Forwarded-For fejlécet,
	# hanem felülírja a közvetlen peer címével. Ez helyes védelem a hamisítás
	# ellen, de a Cloudflare mögött a látogató címét dobja el — és onnantól az
	# app minden látogatót ugyanannak a Cloudflare él-szervernek lát.
	#
	# Frissítés: scripts/cloudflare/trust-proxy.sh --caddy <ez a fájl>
	# Utoljára: 2026-09-17
	#
	# A LÁTOGATÓ CÍME A `CF-Connecting-IP`-BŐL.
	#
	# Az `X-Forwarded-For` egy lánc, amibe a kérés feladója is írhat: egy
	# Cloudflare Workerből indított kérés Cloudflare-címről érkezik, és a
	# láncot a feladó töltheti ki — így bármilyen látogatói címet
	# „megbízhatóan" be lehetett mondani, és a sebességkorlát meg a tiltás
	# kulcsa szabadon választható volt. A `CF-Connecting-IP`-t a Cloudflare
	# maga írja, egyetlen értékként. Csak a fenti tartományokból érkező
	# kérésnél számít; minden más kérésnél a közvetlen peer a látogató.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

animehub.hu, www.animehub.hu {
	# A CLOUDFLARE MEGKERÜLÉSE KIZÁRVA.
	#
	# A `83.229.82.185` cím a világ elől nincs elrejtve, és aki megtudja,
	# `--resolve`-val közvetlenül idejöhet — kipróbálva, HTTP 200-at adott. Az
	# ilyen kérés kihagyja a Cloudflare WAF-ját, a DDoS-elnyelést és a
	# gyorsítótárat: a védelem ott van, csak nem szerepel a láncban.
	#
	# A szokásos megoldás a tűzfalban zárná le a 80/443-at a Cloudflare
	# tartományaira — az viszont ELTÖRNÉ a `yonagifansub.duckdns.org`-ot, ami
	# ugyanezeken a portokon fut, és nincs Cloudflare mögött. Ezért a szűrés
	# NEVENKÉNT van: ez a blokk zár, a többi érintetlen.
	#
	# A Docker-hálózat is engedélyezett: a `docker-proxy` a saját címére
	# fordítja a beérkező kapcsolatot, és a konténerek közti hívások is onnan
	# jönnek.
	#
	# A lista generálva: scripts/cloudflare/trust-proxy.sh --caddy <ez a fájl>
	@nem_cloudflare not remote_ip 172.16.0.0/12 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @nem_cloudflare {
		# 403, nem 404: nem titkoljuk el, hogy van itt valami — csak nem
		# ezen az úton szolgáljuk ki. A kereső- és megfigyelőrobotok a
		# Cloudflare-en át amúgy is elérnek mindent.
		respond "Ez a kiszolgáló a Cloudflare-en keresztül érhető el." 403 {
			close
		}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle {
		# Ugyanaz a beállítás, mint a duckdns-en: a telepítés ne legyen kiesés.
		reverse_proxy yume-app-1:4000 {
			# Egyetlen érték: a fenti szabály szerint megállapított látogató.
			header_up X-Forwarded-For {client_ip}
			health_uri /v1/health
			health_interval 5s
			health_timeout 3s
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}
}

# ---------------------------------------------------------------------------
# discord.animehub.hu — a Discord vezérlőpult
# ---------------------------------------------------------------------------
#
# UGYANAZ AZ ALKALMAZÁS, MÁS NÉVEN — és ez tudatos, nem lustaság.
#
# A vezérlőpult a YUME meglévő bejelentkezését, munkamenetét és API-ját
# használja. Egy külön alkalmazás külön munkamenetet jelentene, és a
# felhasználónak kétszer kellene bejelentkeznie ugyanahhoz a fiókhoz.
#
# A KÜLÖN NÉV MÉGIS INDOKOLT: a Discord OAuth `redirect_uri`-ja rögzített
# cím, és a vezérlőpultnak saját belépési pontja van. A szétválasztás később
# külön gépre költöztethető anélkül, hogy a cím megváltozna.
#
# MÉRVE, MIELŐTT EZ A BLOKK LÉTREJÖTT: a DNS már be volt állítva — ugyanazok
# a Cloudflare-címek, mint az animehub.hu-nál —, de a Caddy nem ismerte ezt a
# nevet, ezért nem tudott tanúsítványt adni. A Cloudflare emiatt `HTTP 525`-öt
# (SSL handshake failed) adott vissza. Nem DNS-hiba volt, hanem origin-oldali.

discord.animehub.hu {
	# A CLOUDFLARE MEGKERÜLÉSE ITT IS KIZÁRVA. Ugyanaz a lista, mint a fő
	# néven: egy vezérlőpult, ami az él megkerülésével is elérhető, pont
	# annyit ér, mint a leggyengébb útja.
	#
	# A lista generálva: scripts/cloudflare/trust-proxy.sh --caddy <ez a fájl>
	@nem_cloudflare not remote_ip 172.16.0.0/12 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @nem_cloudflare {
		respond "Ez a kiszolgáló a Cloudflare-en keresztül érhető el." 403 {
			close
		}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# A VEZÉRLŐPULT A GYÖKÉREN — az API változatlanul.
	#
	# Ezen a néven a `/` NEM a YUME weboldala, hanem a Discord-vezérlőpult:
	# ezért van külön név. Az alkalmazás a vezérlőpultot a `/dashboard`
	# előtag alatt szolgálja ki, tehát minden nem-API címet oda írunk át.
	#
	# MIÉRT ÁTÍRÁS, ÉS NEM KÜLÖN KONTÉNER. Az API-nak ugyanazon az EREDETEN
	# kell lennie, mint a lapnak: így nincs CORS, és a munkamenet ugyanaz a
	# JWT. Egy külön kiszolgáló ugyanezt csak CORS-szal és egy második
	# telepítéssel tudná.
	#
	# AZ API-ELŐTAGOK KIMARADNAK az átírásból. Enélkül a `/v1/...` kérés
	# `/dashboard/v1/...`-ként érkezne, és a vezérlőpult a saját API-ját nem
	# érné el — a lap betöltődne, és utána minden hívás 404 lenne.
	@api path /v1/* /graphql* /graphiql* /ws*
	handle @api {
		reverse_proxy yume-app-1:4000 {
			# Egyetlen érték: a fenti szabály szerint megállapított látogató.
			header_up X-Forwarded-For {client_ip}
			health_uri /v1/health
			health_interval 5s
			health_timeout 3s
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}

	handle {
		rewrite * /dashboard{uri}
		# Ugyanaz a beállítás, mint a többi néven: a telepítés ne legyen kiesés.
		reverse_proxy yume-app-1:4000 {
			# Egyetlen érték: a fenti szabály szerint megállapított látogató.
			header_up X-Forwarded-For {client_ip}
			health_uri /v1/health
			health_interval 5s
			health_timeout 3s
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}
}

yumee.duckdns.org {
	# A RÉGI CÍM — ÁTIRÁNYÍTÁS, NEM MÁSODIK BEJÁRAT.
	#
	# Ez a név a Cloudflare NÉLKÜL szolgálta ki ugyanazt az alkalmazást: WAF,
	# DDoS-elnyelés és gyorsítótár nélkül, miközben az animehub.hu blokkja
	# gondosan kizárta a Cloudflare megkerülését. A kizárás így díszlet volt.
	# A régi hivatkozások tovább működnek — csak már a Cloudflare-en át.
	redir https://animehub.hu{uri} permanent
}
