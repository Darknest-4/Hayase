# Yume — deployment configuration. Copy to .env next to docker-compose.yml:
#   cp .env.example .env && nano .env
# docker compose reads .env automatically.

# REQUIRED. The API refuses to start in production without a real secret.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# REQUIRED. Database password used by postgres, the app and the worker.
# No default anywhere: a password that falls back to a value published in this
# repository is not a password. Generate one with:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- HTTPS (the caddy service) ---
# Your hostname, with an A/AAAA record already pointing at this machine. Caddy
# obtains and renews a Let's Encrypt certificate for it on its own.
# Left EMPTY, the stack serves plain HTTP on :80 — fine for a laptop, not for
# anything with real accounts on it: passwords and tokens cross the network
# readable.
# YUME_DOMAIN=yume.example.com
# Where certificate-expiry notices go.
# ACME_EMAIL=you@example.com

# Which sources may set X-Forwarded-For. The default is the Docker network,
# which is what the bundled caddy needs. Never `true`: that trusts the header
# from anyone and makes rate limiting bypassable by sending a fake one.
# Widen this only for a proxy that is NOT on the compose network.
#
# It must be an address or subnet, never a bare hop count: Fastify 5.12 made a
# numeric value trust nobody, which silently collapses the rate limiter onto a
# single shared bucket. The app refuses to start on one rather than run that way.
# TRUST_PROXY=172.16.0.0/12

# --- backups (the backup service; runs daily and verifies each dump) ---
# BACKUP_KEEP_DAYS=14
# BACKUP_AT_HOUR=3
# Copy each verified backup off this machine. Without it a disk failure still
# ends the project — the dumps sit on the same disk as the database.
# BACKUP_SYNC_CMD='rclone copy "$$1" remote:yume-backups'

# Only needed if the web client is served from a DIFFERENT origin than the API.
# Leave unset for the default single-container deployment (same-origin only).
# CORS_ORIGINS=https://yume.example.com

# Turn on once HTTPS terminates in front of the app (reverse proxy / CDN).
# ENABLE_HSTS=true

# --- SEO ---
# The public address of this site, used for the canonical link, the Open Graph
# URL and the Sitemap: line in robots.txt. SET THIS on any deployment that is
# reachable from the internet. Without it those URLs are built from the Host
# header, which the client chooses — a crawler following a link with a forged
# Host would be told the page's canonical home is somebody else's domain.
# PUBLIC_URL=https://yume.example.com

# How many catalogue entries the sitemap lists, most popular first. The
# protocol caps a single file at 50000; the default keeps the response small
# enough that a crawler is not handed several megabytes on every fetch.
# SITEMAP_MAX_URLS=10000

# --- optional infrastructure (monitoring probes them only when set) ---
# REDIS_URL=redis://redis:6379
# RABBITMQ_URL=amqp://rabbitmq:5672
# OPENSEARCH_URL=http://opensearch:9200
# MINIO_URL=http://minio:9000

# --- rate limiting (defaults shown) ---
# RATE_LIMIT_MAX=1200           # global requests per window per IP (mért alapérték)
# RATE_LIMIT_WINDOW=1 minute
# AUTH_RATE_LIMIT_MAX=10        # login/register per 15 min per IP
# WRITE_RATE_LIMIT_MAX=60       # comments/reports per 5 min per IP
# BODY_LIMIT_BYTES=1048576      # max request body

# --- monitoring (defaults shown) ---
# MONITOR_INTERVAL_MS=60000
# METRICS_RETENTION_DAYS=7

# --- public address ---
# Where viewers reach this instance. Optional, and used for one thing only:
# building links in outbound webhooks, so a message about a report can be
# clicked through to the queue instead of hunted for. It is a public address by
# definition — no credential is ever put in a webhook payload.
# PUBLIC_URL=https://yume.example.com

# Hosts the webhook SSRF guard may deliver to even though they resolve to a
# private address. Only for a receiver on the same machine or network; every
# other host still has to be public.
# WEBHOOK_ALLOWED_HOSTS=127.0.0.1,internal-bot.lan

# ---------------------------------------------------------------- mentés R2-be
#
# A mentés MÁSOLATA a gépen kívülre. Enélkül a dumpok ugyanazon a lemezen ülnek,
# mint az adatbázis, és egy lemezhiba egyszerre viszi mindkettőt — a `backup.sh`
# ezt minden futásnál ki is írja, ha nincs beállítva.
#
# A vödör legyen PRIVÁT: adatbázis-mentés, ami minden felhasználó minden adatát
# tartalmazza. Nyilvános hozzáférést ne kapcsolj rá.
#
# Az API-token jogosultsága legyen a LEHETŐ LEGSZŰKEBB: „Object Read & Write",
# és csak erre az egy vödörre. Egy fiókszintű token, ami mindenhez hozzáfér,
# ennél a feladatnál semmivel nem ad többet, cserébe többet visz, ha kiszivárog.
#
#   R2_ENDPOINT              https://<fiókazonosító>.r2.cloudflarestorage.com
#   R2_BUCKET                a vödör neve
#   R2_PREFIX                útvonal a vödrön belül (alapértelmezés: yume)
#   R2_ACCESS_KEY_ID         az R2 API-token hozzáférési kulcsa
#   R2_SECRET_ACCESS_KEY     a hozzá tartozó titok
#
# A távoli megőrzés a BACKUP_KEEP_DAYS-t követi, tehát a másolatok nem
# gyűlnek örökké.
R2_ENDPOINT=
R2_BUCKET=
R2_PREFIX=yume
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# A katalógus képeinek kiszolgálója. Üresen a saját /media/ útvonal.
# Az R2 saját domainjével: MEDIA_BASE_URL=https://media.animehub.hu
# MEDIA_BASE_URL=
