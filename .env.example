# Yume — deployment configuration. Copy to .env next to docker-compose.yml:
#   cp .env.example .env && nano .env && chmod 600 .env
# docker compose reads .env automatically.
#
# Only the first two values are required. Everything else is optional and
# shown with its default or an example; a line stays commented until you need
# it. These are the settings an operator decides; the code has further
# low-level knobs, each documented at the line that reads it.

# ===========================================================================
# REQUIRED
# ===========================================================================

# The API refuses to start in production without a real secret.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Database password used by postgres, the app, the worker and the gateway.
# No default anywhere: a password that falls back to a value published in this
# repository is not a password. Generate one with:  openssl rand -base64 32
# It is fixed when the database volume is first created.
POSTGRES_PASSWORD=

# ===========================================================================
# PUBLIC ADDRESS, HTTPS AND THE PROXY IN FRONT
# ===========================================================================

# PUBLIC_URL — az oldal saját címe. Ebből készül a kanonikus hivatkozás, az
# Open Graph URL, a robots.txt Sitemap sora és a kimenő webhookok linkjei; ez
# adja az emberpróba gazdanév-ellenőrzésének alapját is, és a worker ennek a
# címnek a /v1/health-ét méri (ha nincs külön EDGE_PROBE_URL). Üresen hagyva a
# Host fejlécből épül, amit a HÍVÓ választ — éles telepítésen állítsd be.
# PUBLIC_URL=https://yume.example.com

# YUME_DOMAIN / ACME_EMAIL — a csomagban lévő Caddy tanúsítványt kér erre a
# gazdanévre (A/AAAA rekord már erre a gépre mutasson). Üresen a :80-on sima
# HTTP megy — laptopon jó, valódi fiókokkal nem: a jelszavak olvashatóan
# utaznak. Megosztott proxy mögött (docker-compose.override.example.yml) a
# beépített Caddy ki van kapcsolva, és ezek nem kellenek.
# YUME_DOMAIN=yume.example.com
# ACME_EMAIL=you@example.com

# TRUST_PROXY — MELY CÍMEKTŐL fogadjuk el az X-Forwarded-For fejlécet.
# Alapból a Docker-hálózat: ez kell a csomagban lévő Caddynek, és a megosztott
# proxynak is. Cloudflare mögött SEM kell ide a Cloudflare tartománya: a proxy
# a CF-Connecting-IP-ből állapítja meg a látogatót, és egyetlen címet ad
# tovább (lásd infrastructure/reverse-proxy). Sosem `true` (mindenkitől elhiszi,
# a sebességkorlát megkerülhető), és sosem puszta hop-szám (Fastify 5.12 óta az
# „senkit" jelent — az app nem is indul el vele).
# TRUST_PROXY=172.16.0.0/12

# ENABLE_HSTS — csak akkor `true`, ha a forgalom tényleg HTTPS. Egy korai
# HSTS-fejléc HTTP-n kiszolgált oldalon elérhetetlenné teszi a telepítést.
# ENABLE_HSTS=true

# Only needed if the web client is served from a DIFFERENT origin than the API.
# Leave unset for the default single-container deployment (same-origin only).
# CORS_ORIGINS=https://yume.example.com

# SERVE_WEB=false turns the app into an API only (when the client is hosted
# elsewhere). API_PUBLIC_URL tells a separately hosted client where the API is.
# SERVE_WEB=true
# API_PUBLIC_URL=https://api.example.com

# How many catalogue entries the sitemap lists, most popular first.
# SITEMAP_MAX_URLS=10000

# ===========================================================================
# ACCOUNTS
# ===========================================================================

# JELSZÓ-VISSZAÁLLÍTÁS. A YUME nem küld e-mailt: a visszaállító tokent egy
# általad üzemeltetett végpontnak adja át (az küldi ki a levelet). Amíg ez
# nincs beállítva, a „Elfelejtett jelszó" semmit nem kézbesít.
# A kérés aláírt:  X-Yume-Timestamp: <ISO idő>
#                  X-Yume-Signature: sha256=<HMAC-SHA256(SECRET, "<idő>.<törzs>")>
# A fogadó számolja újra, időállandó összehasonlítással, és utasítsa el a
# néhány percnél régebbi időbélyeget. A levélben a link:
#   <PUBLIC_URL>/#/reset?token=<token>
# Lásd docs/api/api.md.
# PASSWORD_RESET_WEBHOOK_URL=https://mailer.internal.example/yume-reset
# PASSWORD_RESET_WEBHOOK_SECRET=
# PASSWORD_RESET_TTL_MS=3600000

# Refresh tokens: a token presented again within this window after it was
# rotated is taken for a second tab losing a race; later, for a stolen copy —
# and every session of the account is ended.
# REFRESH_REUSE_GRACE_MS=30000

# Hosts the webhook and reset-delivery guard may reach even though they resolve
# to a private address. Only for a receiver on the same machine or network.
# WEBHOOK_ALLOWED_HOSTS=127.0.0.1,internal-bot.lan

# EMBERPRÓBA (Cloudflare Turnstile). A HELYSZÍN kulcsa nyilvános, a TITOK sosem
# hagyja el a kiszolgálót. Mindkettő hiányában a modul mindent átenged, és a
# widget szkriptje a CSP-be sem kerül.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_PROTECT=register,login          # register, login, forgot
# TURNSTILE_HOSTNAMES=example.com,www.example.com

# ===========================================================================
# RATE LIMITS AND ABUSE CEILINGS (defaults shown)
# ===========================================================================

# These are the starting values; the admin panel (Security → limits) can change
# them at runtime, and what it stores wins.
# RATE_LIMIT_MAX=1200           # global requests per minute per client address
# AUTH_RATE_LIMIT_MAX=10        # login/register per 15 min per address
# REFRESH_RATE_LIMIT_MAX=60     # token refreshes per 15 min per address
# WRITE_RATE_LIMIT_MAX=60       # comments/reports per 5 min per address
# BODY_LIMIT_BYTES=1048576      # max request body
# RATE_LIMIT_TRUST_INTERNAL=true  # own containers (worker, bot) are not limited
# FORUMS_PER_DAY=3              # boards a member (not staff) may open in a day
# XP_EPISODES_PER_DAY=100       # finished episodes that earn XP in a day
# ANIME_STUB_DAILY_MAX=200      # catalogue stubs one account may create a day

# ===========================================================================
# DISCORD (optional — the bot, the gateway container and the dashboard)
# ===========================================================================

# A bot tokenje (Developer Portal → Bot). Nélküle a gateway tétlen, a panel
# pedig jelzi, hogy nincs bot.
# DISCORD_BOT_TOKEN=
# A fiók-összekötés (OAuth2) adatai. A REDIRECT_URI egyezzen a Developer
# Portalon felvett címmel, pl. https://discord.example.com/v1/discord/oauth/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=
# DISCORD_DASHBOARD_URL=https://discord.example.com
# A gateway kapcsolat (jelenlét, tagok). A tag-intentet a Portalon is
# engedélyezni kell, különben a Discord bontja a kapcsolatot.
# DISCORD_GATEWAY_ENABLED=true
# DISCORD_GUILD_MEMBERS_INTENT=false

# ===========================================================================
# MEDIA, STORAGE AND BACKUPS
# ===========================================================================

# A mentés MÁSOLATA a gépen kívülre (Cloudflare R2), és a katalógusképek
# tükre. A vödör legyen PRIVÁT (a mentés mindenki minden adatát tartalmazza),
# az API-token jogosultsága a lehető legszűkebb: „Object Read & Write", csak
# ezekre a vödrökre.
#   R2_ENDPOINT              https://<fiókazonosító>.r2.cloudflarestorage.com
#   R2_BUCKET                a mentések vödre
#   R2_PREFIX                útvonal a vödrön belül (alapértelmezés: yume)
#   R2_MEDIA_BUCKET          a képtükör vödre (alapértelmezés: yume-media)
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
R2_ENDPOINT=
R2_BUCKET=
R2_PREFIX=yume
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_MEDIA_BUCKET=yume-media

# A katalógus képeinek kiszolgálója. Üresen a saját /media/ útvonal.
# MEDIA_BASE_URL=https://media.example.com

# A karbantartási oldal háttérvideójának forrása. Üresen a saját kiszolgáló
# adja — az a lap viszont pont akkor megy ki, amikor a gép bajban van.
# MAINTENANCE_VIDEO_BASE=https://media.example.com/video/maintenance

# A mentés (backup szolgáltatás; naponta fut, és minden dumpot ellenőriz).
# BACKUP_AT_HOUR=3
# BACKUP_KEEP_DAYS=14
# A weboldal KÓDJA is kimegy ugyanoda, a <R2_PREFIX>-code útvonalra: a teljes
# git-előzmény és a lemezen álló kód, csak változáskor. A .env nem kerül bele —
# a titkokat külön, jelszókezelőben őrizd. Lásd scripts/database/backup-code.sh.
# BACKUP_CODE_KEEP=5
# R2_CODE_PREFIX=yume-code
# Enélkül a dumpok ugyanazon a lemezen vannak, mint az adatbázis.
# BACKUP_SYNC_CMD='rclone copy "$$1" remote:yume-backups'

# Trusted Types a CSP-ben (a nyers innerHTML/script.src megtagadása a böngészőben).
# enforce (alap) | report (csak konzolfigyelmeztetés) | off. A `report` a
# visszalépés telepítés nélkül, ha egy külső szkript nem viseli el.
# CSP_TRUSTED_TYPES=enforce

# ===========================================================================
# MONITORING AND DIAGNOSTICS
# ===========================================================================

# MONITOR_INTERVAL_MS=60000
# METRICS_RETENTION_DAYS=7
# EDGE_PROBE_URL — a worker innen kéri le a /v1/health-et a proxyn át, vagyis
# onnan, ahonnan a látogató látja. Üresen a PUBLIC_URL-re esik vissza.
# EDGE_PROBE_URL=https://yume.example.com
#
# Cloudflare Web Analytics: ha a zónán be van kapcsolva, a Cloudflare fűzi be a
# szkriptet, és ez engedi a CSP-ben.
# CLOUDFLARE_ANALYTICS=true
#
# Redis — MA NINCS HASZNÁLATBAN. A kód nem tartalmaz Redis-klienst; beállítva
# ez csak egy elérhetőségi próbát kapcsol be az állapotjelentéshez. Lásd
# docs/operations/redis.md, hogy mikor lesz rá szükség.
# REDIS_URL=redis://redis:6379

# ===========================================================================
# LOAD TESTING (only while a measurement runs)
# ===========================================================================

# LOAD_TEST_KEY — a sebességkorlát alóli kivétel kapuja. Legalább 32 karakter,
# és a mérés végén VEDD KI. LOAD_TEST_IPS: honnan fogadjuk el.
# LOAD_TEST_KEY=
# LOAD_TEST_IPS=127.0.0.1,::1
# LOAD_JWT_SECRET — csak a docker-compose.load.yml elkülönített veremében.
# LOAD_JWT_SECRET=

# ===========================================================================
# TUNING (defaults are right for one VPS; change only after measuring)
# ===========================================================================

# DB_POOL_MAX=20  DB_CONNECTION_TIMEOUT_MS=5000  DB_STATEMENT_TIMEOUT_MS=15000
# REQUEST_TIMEOUT_MS=30000  CONNECTION_TIMEOUT_MS=60000
# JOB_CONCURRENCY=4  JOB_TIMEOUT_MS=600000  JOB_LEASE_TIMEOUT_MS=120000
# PERMISSION_CACHE_TTL_MS=30000  PROVIDER_CACHE_MAX=5000
# GRAPHQL_MAX_DEPTH=10  GRAPHQL_MAX_LENGTH=8000
# LOG_LEVEL=info
